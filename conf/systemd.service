[Unit]
Description=KOReader sync server (__APP__)
After=network.target __APP__-redis.service
Requires=__APP__-redis.service

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/app
Environment=GIN_ENV=production
Environment=ENABLE_USER_REGISTRATION=__ENABLE_USER_REGISTRATION__
Environment=PATH=__INSTALL_DIR__/openresty/nginx/sbin:__INSTALL_DIR__/openresty/bin:/usr/bin:/bin
# OpenResty was built for /opt/openresty: point Lua at its relocated libraries
Environment=LUA_PATH=__INSTALL_DIR__/openresty/site/lualib/?.lua;__INSTALL_DIR__/openresty/lualib/?.lua;__INSTALL_DIR__/openresty/lualib/?/init.lua;__INSTALL_DIR__/lua/share/lua/5.1/?.lua;__INSTALL_DIR__/lua/share/lua/5.1/?/init.lua;;
Environment=LUA_CPATH=__INSTALL_DIR__/openresty/site/lualib/?.so;__INSTALL_DIR__/openresty/lualib/?.so;__INSTALL_DIR__/lua/lib/lua/5.1/?.so;;
ExecStart=/usr/bin/lua5.1 __INSTALL_DIR__/lua/bin/gin start
Restart=on-failure
RestartSec=5

# Sandboxing options to harden security
# (no MemoryDenyWriteExecute: LuaJIT needs to JIT-compile code)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
