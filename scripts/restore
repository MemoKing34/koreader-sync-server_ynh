#!/bin/bash

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE FILES AND SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Restoring files and system configurations..."

ynh_restore_everything

_set_permissions

systemctl daemon-reload
systemctl enable "${app}-redis.service" --quiet
systemctl enable "$app.service" --quiet

_register_services

#=================================================
# RELOAD NGINX AND START SERVICES
#=================================================
ynh_script_progression "Reloading NGINX web server and $app's services..."

ynh_systemctl --service="${app}-redis" --action="start"
ynh_systemctl --service="$app" --action="start"

ynh_systemctl --service=nginx --action=reload

ynh_script_progression "Restoration completed for $app"
