#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Removing system configurations..."

if ynh_hide_warnings yunohost service status "$app" >/dev/null; then
    yunohost service remove "$app"
fi
if ynh_hide_warnings yunohost service status "${app}-redis" >/dev/null; then
    yunohost service remove "${app}-redis"
fi

ynh_systemctl --service="$app" --action="stop" --log_path="system"
ynh_systemctl --service="${app}-redis" --action="stop" --log_path="system"

ynh_config_remove_systemd
ynh_safe_rm "/etc/systemd/system/${app}-redis.service"
systemctl daemon-reload

ynh_config_remove_nginx

ynh_safe_rm "/etc/${app}"
ynh_safe_rm "/var/log/${app}"

ynh_script_progression "Removal of $app completed"
