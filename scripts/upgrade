#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_systemctl --service="$app" --action="stop"
ynh_systemctl --service="${app}-redis" --action="stop"

enable_user_registration=$(ynh_app_setting_get --key=enable_user_registration)
set_registration_setting

ynh_script_progression "Upgrading source files..."
ynh_setup_source --dest_dir="$install_dir" --full_replace --keep="openresty rocks logs tmp"

build_openresty
build_luarocks_stack
configure_app_files
setup_system_configs

ynh_script_progression "Restarting services..."
ynh_systemctl --service="${app}-redis" --action="restart"
ynh_systemctl --service="$app" --action="restart"

ynh_script_progression "Upgrade of $app completed"
